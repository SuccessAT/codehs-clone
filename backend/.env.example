# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./codehs.db

# For PostgreSQL (uncomment for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codehs

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# E2B API Key for secure code execution (get from https://e2b.dev)
E2B_API_KEY=your_e2b_api_key_here
